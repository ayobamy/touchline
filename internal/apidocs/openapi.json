{
  "openapi": "3.1.1",
  "info": {
    "title": "Touchline server",
    "version": "0.3.0",
    "summary": "Live match statistics for Touchline's agents and viewer.",
    "description": "The Touchline server replays a synthetic football match through a deterministic stats engine and serves it two ways:\n\n- **Match API** (`/api/*`): small JSON endpoints for the agent orchestrator and the pitch view.\n- **MCP** (`/mcp`): nine read-only tools for AI agents over the Model Context Protocol's streamable HTTP transport.\n\nEvery number comes from the stats engine; agents explain numbers but never compute them. All data is synthetic and every club and player is fictional.\n\nThe Event, Match and Overlay schemas below are the published contracts in `schema/`, embedded at build time.",
    "license": { "name": "MIT", "identifier": "MIT" }
  },
  "servers": [{ "url": "/", "description": "This server" }],
  "tags": [
    { "name": "Match API", "description": "JSON endpoints for the orchestrator and the pitch view." },
    { "name": "MCP", "description": "Model Context Protocol endpoint for AI agents: JSON-RPC 2.0, one message per POST, plain JSON responses. Supports `initialize`, `notifications/initialized`, `ping`, `tools/list` and `tools/call`." },
    { "name": "Service", "description": "Health and documentation." }
  ],
  "paths": {
    "/api/status": {
      "get": {
        "tags": ["Match API"],
        "operationId": "getStatus",
        "summary": "Match status",
        "description": "Period, clock, score, and how many events and candidate moments have happened so far.",
        "responses": {
          "200": {
            "description": "The current status.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Status" },
                "example": { "match_id": "m-0001", "period": 2, "clock_ms": 3818578, "clock": "63:38", "score": { "home": 2, "away": 3 }, "events": 1245, "moments": 18, "finished": false }
              }
            }
          }
        }
      }
    },
    "/api/match": {
      "get": {
        "tags": ["Match API"],
        "operationId": "getMatch",
        "summary": "Match details",
        "description": "Teams, players, venue, seed and scenario. Every name is fictional.",
        "responses": {
          "200": {
            "description": "The match.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Match" } } }
          }
        }
      }
    },
    "/api/snapshot": {
      "get": {
        "tags": ["Match API"],
        "operationId": "getSnapshot",
        "summary": "Running statistics",
        "description": "Cumulative team and player statistics, plus momentum, pressure index, chaos and rhythm over the last five minutes of the current half.",
        "responses": {
          "200": {
            "description": "The latest snapshot.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Snapshot" } } }
          }
        }
      }
    },
    "/api/moments": {
      "get": {
        "tags": ["Match API"],
        "operationId": "listMoments",
        "summary": "Candidate moments",
        "description": "Moments the rules engine has flagged for the agents, in order. Poll with `after` set to the `next` value of the previous call to receive only new ones.",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "description": "How many moments you have already seen. Omit, or pass 0, for all of them.",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Moments after `after`, and the value to pass next time.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MomentsPage" },
                "example": {
                  "moments": [
                    { "id": "m-0001-mo-018", "match_id": "m-0001", "kind": "press_switch", "period": 2, "clock_ms": 3818578, "team_id": "iro", "summary": "Ironbridge Rovers step up their press: pressure index 6.0, up from 2.1", "metrics": { "pressure_index": 6, "pressure_index_before": 2.1 }, "event_ids": ["m-0001-01211", "m-0001-01214", "m-0001-01218", "m-0001-01226", "m-0001-01227", "m-0001-01244"] }
                  ],
                  "next": 18
                }
              }
            }
          },
          "400": {
            "description": "`after` is not a non-negative integer.",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "tags": ["MCP"],
        "operationId": "mcpMessage",
        "summary": "Send one MCP message",
        "description": "One JSON-RPC 2.0 message per request. Requests get a JSON response; notifications get 202 with no body. The response to `initialize` carries an `Mcp-Session-Id` header. Tool failures (bad arguments, unknown IDs) come back as results with `isError: true`, not as JSON-RPC errors, so a model can read them and correct itself.\n\nTools: `get_match`, `get_status`, `get_snapshot`, `get_player_stats`, `get_window`, `get_events`, `get_event`, `compare_periods`, `list_moments`. Call `tools/list` for their input schemas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JsonRpcRequest" },
              "examples": {
                "initialize": {
                  "summary": "Start a session",
                  "value": { "jsonrpc": "2.0", "id": 1, "method": "initialize", "params": { "protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": { "name": "example", "version": "1.0" } } }
                },
                "toolsList": {
                  "summary": "List the tools",
                  "value": { "jsonrpc": "2.0", "id": 2, "method": "tools/list" }
                },
                "getStatus": {
                  "summary": "Call get_status",
                  "value": { "jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": { "name": "get_status", "arguments": {} } }
                },
                "comparePeriods": {
                  "summary": "Call compare_periods",
                  "value": { "jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": { "name": "compare_periods", "arguments": { "metric": "pressure_index", "a": { "period": 2, "from_ms": 3218578, "to_ms": 3518578 }, "b": { "period": 2, "from_ms": 3518578, "to_ms": 3818578 } } } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The JSON-RPC response.",
            "headers": {
              "Mcp-Session-Id": {
                "description": "Sent in reply to `initialize`. The server keeps no session state, so clients may send it back or not.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JsonRpcResponse" },
                "example": { "jsonrpc": "2.0", "id": 3, "result": { "content": [{ "type": "text", "text": "{\"match_id\":\"m-0001\",\"period\":2,\"clock\":\"63:38\"}" }], "structuredContent": { "match_id": "m-0001", "period": 2, "clock": "63:38" }, "isError": false } }
              }
            }
          },
          "202": { "description": "A notification was accepted; there is no response body." },
          "413": { "description": "The request body was larger than 1 MiB or unreadable." }
        }
      },
      "delete": {
        "tags": ["MCP"],
        "operationId": "mcpEndSession",
        "summary": "End a session",
        "description": "Accepted for compatibility with MCP clients. Sessions hold no state.",
        "responses": { "204": { "description": "Done." } }
      }
    },
    "/healthz": {
      "get": {
        "tags": ["Service"],
        "operationId": "health",
        "summary": "Liveness check",
        "responses": {
          "200": { "description": "The server is up.", "content": { "text/plain": { "schema": { "type": "string" }, "example": "ok\n" } } }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["Service"],
        "operationId": "openapi",
        "summary": "This OpenAPI document",
        "responses": {
          "200": { "description": "OpenAPI 3.1 document.", "content": { "application/json": { "schema": { "type": "object" } } } }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": ["Service"],
        "operationId": "docs",
        "summary": "API reference",
        "description": "This document rendered with Scalar.",
        "responses": {
          "200": { "description": "HTML page.", "content": { "text/html": { "schema": { "type": "string" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Score": {
        "type": "object",
        "required": ["home", "away"],
        "additionalProperties": false,
        "properties": {
          "home": { "type": "integer", "minimum": 0 },
          "away": { "type": "integer", "minimum": 0 }
        }
      },
      "Status": {
        "type": "object",
        "required": ["match_id", "period", "clock_ms", "clock", "score", "events", "moments", "finished"],
        "additionalProperties": false,
        "properties": {
          "match_id": { "type": "string" },
          "period": { "type": "integer", "description": "1 or 2; 0 before kick-off." },
          "clock_ms": { "type": "integer", "description": "Match clock in milliseconds. The second half starts at 2700000 (45:00)." },
          "clock": { "type": "string", "description": "The clock as minutes and seconds, e.g. 63:38." },
          "score": { "$ref": "#/components/schemas/Score" },
          "events": { "type": "integer", "description": "Events applied so far." },
          "moments": { "type": "integer", "description": "Candidate moments flagged so far." },
          "finished": { "type": "boolean", "description": "True after the full-time event." }
        }
      },
      "TeamStats": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "team_id": { "type": "string" },
          "passes": { "type": "integer" },
          "passes_completed": { "type": "integer" },
          "pass_accuracy_pct": { "type": "number" },
          "avg_pass_distance_m": { "type": "number" },
          "shots": { "type": "integer" },
          "shots_on_target": { "type": "integer", "description": "Saved shots and goals." },
          "goals": { "type": "integer" },
          "xg": { "type": "number", "description": "Sum of expected goals over the team's shots." },
          "max_shot_speed_kmh": { "type": "number" },
          "tackles": { "type": "integer" },
          "tackles_won": { "type": "integer" },
          "interceptions": { "type": "integer" },
          "pressures": { "type": "integer" },
          "fouls": { "type": "integer" },
          "yellow_cards": { "type": "integer" },
          "red_cards": { "type": "integer" },
          "possession_pct": { "type": "number" }
        }
      },
      "PlayerStats": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "player_id": { "type": "string" },
          "team_id": { "type": "string" },
          "touches": { "type": "integer" },
          "passes": { "type": "integer" },
          "passes_completed": { "type": "integer" },
          "pass_accuracy_pct": { "type": "number" },
          "avg_pass_difficulty": { "type": "number", "description": "Mean pass difficulty, 0 to 10." },
          "shots": { "type": "integer" },
          "goals": { "type": "integer" },
          "xg": { "type": "number" },
          "tackles_won": { "type": "integer" },
          "interceptions": { "type": "integer" },
          "pressures": { "type": "integer" }
        }
      },
      "Window": {
        "type": "object",
        "description": "A recent stretch of the current half.",
        "additionalProperties": false,
        "properties": {
          "minutes": { "type": "integer" },
          "momentum": { "type": "number", "minimum": -1, "maximum": 1, "description": "-1 is the away team on top, +1 the home team." },
          "pressure_index": { "type": "object", "additionalProperties": { "type": "number" }, "description": "Pressures per 10 opponent passes, by team ID." },
          "chaos_per_min": { "type": "number", "description": "Possession changes per minute." },
          "rhythm_per_min": { "type": "number", "description": "Events per minute." }
        }
      },
      "Snapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "match_id": { "type": "string" },
          "period": { "type": "integer" },
          "clock_ms": { "type": "integer" },
          "score": { "$ref": "#/components/schemas/Score" },
          "teams": { "type": "array", "items": { "$ref": "#/components/schemas/TeamStats" } },
          "players": { "type": ["array", "null"], "items": { "$ref": "#/components/schemas/PlayerStats" } },
          "window": { "$ref": "#/components/schemas/Window" }
        }
      },
      "Moment": {
        "type": "object",
        "description": "A candidate moment for the agents, with the events that justify it.",
        "required": ["id", "match_id", "kind", "period", "clock_ms", "summary", "event_ids"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "examples": ["m-0001-mo-018"] },
          "match_id": { "type": "string" },
          "kind": { "enum": ["goal", "big_chance", "key_pass", "card", "momentum_swing", "press_switch", "chaos_spell", "player_milestone"] },
          "period": { "type": "integer" },
          "clock_ms": { "type": "integer" },
          "team_id": { "type": "string" },
          "player_id": { "type": "string" },
          "summary": { "type": "string", "description": "Plain English, using player and club names." },
          "metrics": { "type": "object", "additionalProperties": { "type": "number" }, "description": "The numbers the rule fired on, computed at the moment." },
          "event_ids": { "type": "array", "items": { "type": "string" }, "description": "Up to six evidence events." }
        }
      },
      "MomentsPage": {
        "type": "object",
        "required": ["moments", "next"],
        "additionalProperties": false,
        "properties": {
          "moments": { "type": "array", "items": { "$ref": "#/components/schemas/Moment" } },
          "next": { "type": "integer", "description": "Pass as `after` on the next call." }
        }
      },
      "JsonRpcRequest": {
        "type": "object",
        "required": ["jsonrpc", "method"],
        "properties": {
          "jsonrpc": { "const": "2.0" },
          "id": { "type": ["string", "integer"], "description": "Omit for a notification." },
          "method": { "type": "string", "examples": ["initialize", "tools/list", "tools/call"] },
          "params": { "type": "object" }
        }
      },
      "JsonRpcResponse": {
        "type": "object",
        "required": ["jsonrpc", "id"],
        "properties": {
          "jsonrpc": { "const": "2.0" },
          "id": { "type": ["string", "integer", "null"] },
          "result": { "type": "object", "description": "For tools/call: `content` (text), `structuredContent` (the same JSON as an object) and `isError`." },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "integer", "description": "-32700 parse error, -32600 invalid request, -32601 method not found, -32602 invalid params." },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
