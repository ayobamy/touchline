{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ayobamy/touchline/schema/overlay.schema.json",
  "title": "Overlay",
  "description": "One timed, machine-readable on-screen graphic. Every overlay must cite the events that back it.",
  "type": "object",
  "required": ["id", "match_id", "period", "show_at_ms", "ttl_ms", "priority", "slot", "audience", "locale", "headline", "evidence_event_ids", "producer"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "match_id": { "type": "string" },
    "period": { "enum": [1, 2] },
    "show_at_ms": { "type": "integer", "minimum": 0, "description": "Match clock time at which to show the overlay." },
    "ttl_ms": { "type": "integer", "minimum": 2000, "maximum": 30000, "description": "How long it stays on screen." },
    "priority": { "type": "integer", "minimum": 1, "maximum": 5, "description": "1 is most urgent; the Director drops lower priorities when slots collide." },
    "slot": { "enum": ["lower_third", "top_bar", "side_panel", "full_screen"] },
    "audience": { "enum": ["analyst", "casual", "all"] },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "description": "BCP 47 tag, e.g. en, pcm (Nigerian Pidgin), yo (Yoruba)." },
    "team_id": { "type": "string" },
    "player_id": { "type": "string" },
    "headline": { "type": "string", "minLength": 1, "maxLength": 60 },
    "body": { "type": "string", "maxLength": 160 },
    "metrics": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "unit": { "type": "string" }
        }
      }
    },
    "evidence_event_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "producer": { "type": "string", "description": "The agent or template that wrote the overlay." },
    "fallback": { "type": "boolean", "description": "True when the Director substituted a template because an agent failed or timed out." }
  }
}
